<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 HTTP 白名单。

  连通性锚点（generate_204 类）绝大多数只有明文 HTTP，没有 TLS——go-cnal 的
  L1 锚点也是 http://（probe_ips=223.5.5.5 等）。而 targetSdk ≥28 起系统默认
  **禁止** cleartext，探针会直接抛 "Cleartext HTTP traffic not permitted"。

  这里只放行锚点域名与回路面板，不用 android:usesCleartextTraffic="true"
  —— 后者对整个 app 生效，范围过大（android-plan §8 风险 5 的同一条纪律）。

  127.0.0.1 是 M1 的 WebView 面板回路（http://127.0.0.1:<port>/panel）：
  M0 实测已证实 targetSdk≥28 会把明文 HTTP 直接拦成
  "Cleartext HTTP traffic ... not permitted"（docs/m0-findings.md §2）。
  loopback 不受默认网络绑定影响，但 cleartext 规则一视同仁，必须显式放行。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">connect.rom.miui.com</domain>
        <!-- 回路面板：端口由内核随机分配，域名只认 127.0.0.1。
             includeSubdomains 显式 false：IP 无子域，且 lint 要求必填。 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
